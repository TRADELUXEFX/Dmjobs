<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <!-- App Brand Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:text="DM Jobs"
                android:textAlignment="center"
                android:textColor="@color/green_deep"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Choose an outreach campaign"
                android:textAlignment="center"
                android:textColor="@color/text_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Global Notification/Error Banner -->
        <TextView
            android:id="@+id/login_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/error_bg"
            android:gravity="center"
            android:padding="10dp"
            android:textColor="@color/red"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Navigation Tabs: Browse Jobs vs Enter Code -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/tab_container_bg"
            app:tabGravity="fill"
            app:tabIndicatorColor="@color/green_deep"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorHeight="3dp"
            app:tabMode="fixed"
            app:tabRippleColor="#1A075E54"
            app:tabSelectedTextColor="@color/green_deep"
            app:tabTextAppearance="@android:style/TextAppearance.Widget.TabWidget"
            app:tabTextColor="@color/text_muted">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Browse Jobs" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter Job Code" />
        </com.google.android.material.tabs.TabLayout>

        <!-- ============================================== -->
        <!-- TAB 1: BROWSE JOBS SECTION                     -->
        <!-- ============================================== -->
        <LinearLayout
            android:id="@+id/layout_browse_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Search and Refresh Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Search Input Container -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/search_input_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Search"
                        android:src="@drawable/ic_search" />

                    <EditText
                        android:id="@+id/inp_search_jobs"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Search jobs by name or code..."
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/text"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/btn_clear_search"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Clear"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:visibility="gone"
                        app:tint="@color/text_muted" />
                </LinearLayout>

                <!-- Refresh Button -->
                <ImageButton
                    android:id="@+id/btn_refresh_jobs"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/search_input_bg"
                    android:contentDescription="Refresh available jobs"
                    android:padding="13dp"
                    android:src="@drawable/ic_refresh" />
            </LinearLayout>

            <!-- Filter Toggle Row: Available, In Progress, Completed -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Filter 1: Available -->
                    <Button
                        android:id="@+id/btn_filter_available"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/chip_filter_selected"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="18dp"
                        android:text="Available"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Filter 2: In Progress -->
                    <Button
                        android:id="@+id/btn_filter_in_progress"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/chip_filter_unselected"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="18dp"
                        android:text="In Progress"
                        android:textAllCaps="false"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Filter 3: Completed -->
                    <Button
                        android:id="@+id/btn_filter_completed"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/chip_filter_unselected"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="18dp"
                        android:text="Completed"
                        android:textAllCaps="false"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Results Count Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/jobs_count_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Available Campaigns"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Loading Indicator -->
            <LinearLayout
                android:id="@+id/jobs_loading_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:indeterminateTint="@color/green_deep" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Loading campaigns..."
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Empty State Card (MaterialCardView with full unclipped curves) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/jobs_empty_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                android:layout_marginVertical="10dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardPreventCornerOverlap="true"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="26dp">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:alpha="0.4"
                        android:contentDescription="No jobs"
                        android:src="@drawable/ic_work" />

                    <TextView
                        android:id="@+id/empty_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="No Campaigns Available"
                        android:textColor="@color/text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/empty_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Check back shortly or contact the administrator."
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_retry_fetch_jobs"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/button_rounded_secondary"
                        android:paddingHorizontal="20dp"
                        android:text="Refresh List"
                        android:textAllCaps="false"
                        android:textColor="@color/green_deep"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Jobs List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_jobs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

        <!-- ============================================== -->
        <!-- TAB 2: ENTER CODE SECTION                      -->
        <!-- ============================================== -->
        <LinearLayout
            android:id="@+id/layout_code_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                android:layout_marginVertical="6dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardPreventCornerOverlap="true"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/pay_badge_bg"
                        android:contentDescription="Job Code"
                        android:padding="12dp"
                        android:src="@drawable/ic_key"
                        app:tint="@color/green_deep" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Enter Private Campaign Code"
                        android:textColor="@color/text"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Type your assigned job code below to open your batch."
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/inp_manual_jobcode"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/input_bg"
                        android:gravity="center"
                        android:hint="e.g. ADEHV6"
                        android:inputType="textCapCharacters"
                        android:letterSpacing="0.15"
                        android:maxLength="10"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/text"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/code_error_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/error_bg"
                        android:gravity="center"
                        android:padding="10dp"
                        android:textColor="@color/red"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <!-- ACTION BUTTON WITH INLINE CENTERED SPINNER -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="18dp">

                        <Button
                            android:id="@+id/btn_verify_code"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/button_rounded"
                            android:text="Find &amp; Select Job"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/code_progress"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="@color/white"
                            android:visibility="gone" />
                    </FrameLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Help / Admin Contact Button -->
        <Button
            android:id="@+id/btn_no_job"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/button_rounded_wa"
            android:text="Need a Job Code? Contact Admin"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
